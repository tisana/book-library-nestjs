{
  "compilerOptions": {
    "module": "NodeNext",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "target": "es2017",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "moduleResolution": "NodeNext",
    "rootDir": ".",
    "strict": false,
    "types": ["node", "jest"],
    "isolatedModules": true
  },
  "exclude": ["node_modules", "dist", "dist-performance", "frontend"]
}
